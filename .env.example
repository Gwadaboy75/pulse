# demo: generated data, one shared demo user.
# google: real accounts; each user connects their Google account (needs the Google OAuth client below), and may also
#         pair their phone's Health Connect (docs/health-connect.md).
# health-connect: real accounts fed by the phone alone (Fitbit app -> Health Connect -> Life Dashboard Companion ->
#         this server). No Google OAuth client needed. APP_URL is required: the pairing code points the phone at it.
# demo creds:
#   email: demo@pulse.local
#   password: pulse-demo-generated-data
DATA_SOURCE=demo

# Postgres password for compose.yaml (it builds DATABASE_URL from it).
POSTGRES_PASSWORD=
# Outside compose only. Default: postgres://pulse:pulse@localhost:5432/pulse
# DATABASE_URL=

# Session signing key: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Owners: comma-separated emails that open the admin panel (/admin). On a server with no accounts the first one
# signs up without an invite: create it right after the first start (emails aren't verified). Already running?
# Use your existing account's email.
# ADMIN_EMAILS=you@example.com
# Starting sign-up mode until an admin changes it in the panel: invite (default), open or closed.
# SIGNUP=invite

# AI coach: turned on per server in the admin panel; each person adds their own provider key in Pulse.
# Optional: a model you run yourself (Ollama, LM Studio, vLLM), offered to everyone with no key needed.
# COACH_LOCAL_URL=http://localhost:11434/v1
# COACH_LOCAL_MODEL=llama3.2
# Shown on the forgot-password page so people can ask you for a reset.
# SUPPORT_EMAIL=you@example.com

# Google OAuth client (when DATA_SOURCE=google). Redirect URI: <APP_URL>/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The address people (and the phone) reach Pulse at. Required with DATA_SOURCE=health-connect.
# APP_URL=https://pulse.example.com

# Notifications (Web Push): npx web-push generate-vapid-keys. Set all three or none.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Android APK (e.g. packaged with PWABuilder, docs/pwa.md): served as /.well-known/assetlinks.json. Set both or none.
# ANDROID_PACKAGE_NAME=in.example.pulse
# ANDROID_CERT_SHA256=AB:CD:...   (sha256_cert_fingerprints from PWABuilder's assetlinks.json; comma-separate several)

# Médical › Documents: where uploads are kept (compose mounts a volume there) and the largest upload, in bytes.
# DOCUMENTS_DIR=data/documents
# DOCUMENTS_MAX_BYTES=26214400

# PORT=3000
# compose.yaml publishes no host port. To reach Pulse from the host, add one in compose.override.yaml (docs/setup.md).
# AVATAR_URL=
